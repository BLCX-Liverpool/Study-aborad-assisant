APP_NAME="Study Abroad Assistant API"
APP_ENV="development"
API_PREFIX="/api"

DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/study_abroad_assistant"
REDIS_URL="redis://localhost:6379/0"

RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
RABBITMQ_VHOST="/"
RABBITMQ_WORKFLOW_ENABLED=false
LEGACY_LONG_TASK_ENDPOINTS_ENABLED=false
RABBITMQ_QUEUE_TYPE="quorum"
RABBITMQ_DECLARE_TOPOLOGY=true
RABBITMQ_HEARTBEAT_SECONDS=30
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_MESSAGE_MAX_BYTES=131072
RABBITMQ_SINGLE_ACTIVE_CONSUMER_QUEUES='["study.workflow.prepare.q","study.orchestrator.events.q"]'
ASYNC_INTENTS='["assignment","travel","finance","task_planning","email","notice_action","social_content"]'
ASYNC_ROLLOUT_PERCENTAGE=100
ASYNC_USER_ALLOWLIST='[]'
WORKFLOW_LEASE_SECONDS=300
WORKFLOW_SSE_POLL_SECONDS=1.0
WORKFLOW_SSE_TIMEOUT_SECONDS=300
WORKFLOW_OUTBOX_BATCH_SIZE=100
WORKFLOW_SCHEDULER_POLL_SECONDS=10.0
ADMIN_API_KEY=""
AUTH_TOKEN_SECRET="development-only-change-me"
AUTH_TOKEN_TTL_SECONDS=86400
RABBITMQ_MANAGEMENT_URL="http://localhost:15672"
RABBITMQ_MANAGEMENT_USERNAME="guest"
RABBITMQ_MANAGEMENT_PASSWORD="guest"

LLM_PROVIDER="openai_compatible"
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
ROUTER_LLM_MODEL=""
ROUTER_EMBEDDING_MODEL=""
NOTICE_LLM_MODEL=""
ASSIGNMENT_LLM_MODEL=""
PLANNER_LLM_MODEL=""
EMAIL_LLM_MODEL=""
TRAVEL_LLM_MODEL=""
FINANCE_LLM_MODEL=""
FITNESS_LLM_MODEL=""
SOCIAL_LLM_MODEL=""
MEMORY_LLM_MODEL=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
# Optional explicit proxy used by the OpenAI-compatible client. For the bundled
# Docker Desktop bridge: http://host.docker.internal:18080
LLM_PROXY_URL=""
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

OCR_ENGINE="auto"
OCR_PDF_RENDER_SCALE=2.0
OCR_MAX_PAGES=20
DEEPDOC_PYTHON="./.venv_deepdoc/bin/python"
DEEPDOC_MODEL_HOME="./models/deepdoc"
DEEPDOC_TIMEOUT_SECONDS=180

TAVILY_MCP_ENABLED=false
TAVILY_MCP_ENDPOINT="https://mcp.tavily.com/mcp/"
TAVILY_API_KEY=""
TAVILY_MCP_TOOL_CACHE_TTL_SECONDS=300
TAVILY_MCP_SEARCH_TIMEOUT_SECONDS=30
TAVILY_MCP_EXTRACT_TIMEOUT_SECONDS=60
TAVILY_MCP_MAP_TIMEOUT_SECONDS=60
TAVILY_MCP_CRAWL_TIMEOUT_SECONDS=180
TAVILY_MCP_MAX_SSE_EVENT_SIZE=1048576
TAVILY_MCP_MAX_PAGE_CHARS=50000
TAVILY_MCP_MAX_TOTAL_CHARS=200000

GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_LANGUAGE="zh-CN"
GOOGLE_MAPS_REGION=""
GOOGLE_MAPS_TIMEOUT_SECONDS=10

QQ_SMTP_HOST="smtp.qq.com"
QQ_SMTP_PORT=465
QQ_SMTP_USERNAME=""
QQ_SMTP_PASSWORD=""
QQ_SMTP_FROM_EMAIL=""
QQ_SMTP_FROM_NAME="Study Abroad Assistant"

OUTLOOK_SMTP_HOST="smtp.office365.com"
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_USERNAME=""
OUTLOOK_SMTP_PASSWORD=""
OUTLOOK_SMTP_FROM_EMAIL=""
OUTLOOK_SMTP_FROM_NAME="Study Abroad Assistant"

UPLOAD_STORAGE_DIR="./.data/uploads"
RESEARCH_SOURCE_STORAGE_DIR="./.data/research_sources"
