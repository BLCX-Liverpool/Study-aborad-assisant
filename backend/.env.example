APP_NAME="Study Abroad Assistant API"
APP_ENV="development"
API_PREFIX="/api"

DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/study_abroad_assistant"
REDIS_URL="redis://localhost:6379/0"

RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
RABBITMQ_VHOST="/"
RABBITMQ_WORKFLOW_ENABLED=false
RABBITMQ_QUEUE_TYPE="quorum"
RABBITMQ_HEARTBEAT_SECONDS=30
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_MESSAGE_MAX_BYTES=131072
ASYNC_INTENTS='["assignment","travel","finance","task_planning","email","notice_action","social_content"]'
ASYNC_ROLLOUT_PERCENTAGE=100
ASYNC_USER_ALLOWLIST='[]'
WORKFLOW_LEASE_SECONDS=300
WORKFLOW_SSE_POLL_SECONDS=1.0
WORKFLOW_SSE_TIMEOUT_SECONDS=300
WORKFLOW_OUTBOX_BATCH_SIZE=100
WORKFLOW_SCHEDULER_POLL_SECONDS=10.0
ADMIN_API_KEY=""

LLM_PROVIDER="openai_compatible"
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
ROUTER_LLM_MODEL=""
ROUTER_EMBEDDING_MODEL=""
NOTICE_LLM_MODEL=""
ASSIGNMENT_LLM_MODEL=""
PLANNER_LLM_MODEL=""
EMAIL_LLM_MODEL=""
TRAVEL_LLM_MODEL=""
FINANCE_LLM_MODEL=""
FITNESS_LLM_MODEL=""
SOCIAL_LLM_MODEL=""
MEMORY_LLM_MODEL=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""

OCR_ENGINE="auto"
OCR_PDF_RENDER_SCALE=2.0
OCR_MAX_PAGES=20
DEEPDOC_PYTHON="./.venv_deepdoc/bin/python"
DEEPDOC_MODEL_HOME="./models/deepdoc"
DEEPDOC_TIMEOUT_SECONDS=180

BROWSER_MCP_ENABLED=false
BROWSER_MCP_ENDPOINT=""
BROWSER_MCP_COMMAND=""
BROWSER_MCP_TOOL="browser.search_extract"
BROWSER_MCP_SEARCH_TOOL=""
BROWSER_MCP_EXTRACT_TOOL=""
BROWSER_MCP_AUTH_TOKEN=""
BROWSER_MCP_TIMEOUT_SECONDS=30

GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_LANGUAGE="zh-CN"
GOOGLE_MAPS_REGION=""
GOOGLE_MAPS_TIMEOUT_SECONDS=10

QQ_SMTP_HOST="smtp.qq.com"
QQ_SMTP_PORT=465
QQ_SMTP_USERNAME=""
QQ_SMTP_PASSWORD=""
QQ_SMTP_FROM_EMAIL=""
QQ_SMTP_FROM_NAME="Study Abroad Assistant"

OUTLOOK_SMTP_HOST="smtp.office365.com"
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_USERNAME=""
OUTLOOK_SMTP_PASSWORD=""
OUTLOOK_SMTP_FROM_EMAIL=""
OUTLOOK_SMTP_FROM_NAME="Study Abroad Assistant"

UPLOAD_STORAGE_DIR="./.data/uploads"
RESEARCH_SOURCE_STORAGE_DIR="./.data/research_sources"
